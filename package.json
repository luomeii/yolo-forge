{
  "name": "yolo-forge-sp",
  "version": "1.0.0-sp",
  "description": "YOLO-Forge SP — Rebuilt from the ground up as an intelligent YOLO dataset workstation with Codex/Claude Code architecture patterns",
  "main": "dist/electron/main.js",
  "author": "YOLO-Forge SP Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json || echo \"[WARN] TypeScript had errors but continuing...\"",
    "build:all": "vite build && tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && npm run build:electron && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build:all && electron-builder",
    "electron:build:mac": "npm run build:all && electron-builder --mac",
    "electron:build:linux": "npm run build:all && electron-builder --linux",
    "electron:build:win": "npm run build:all && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "clean": "rimraf dist release",
    "python:install": "pip install -r electron/python/requirements.txt",
    "python:test": "python -c \"import sys; sys.path.insert(0,'electron/python'); from worker import handle_inspect; print('Python worker OK')\"",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "start": "cross-env NODE_ENV=development electron ."
  },
  "dependencies": {
    "openai": "^4.95.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "zod": "^3.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "chokidar": "^4.0.0",
    "yaml": "^2.7.0",
    "marked": "^15.0.0",
    "highlight.js": "^11.11.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.0",
    "@tailwindcss/postcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0"
  },
  "build": {
    "appId": "com.yoloforge.sp",
    "productName": "YOLO-Forge SP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/python/**/*",
      "!node_modules",
      "!src"
    ],
    "extraResources": [
      {
        "from": "electron/python",
        "to": "python",
        "filter": [
          "**/*.py",
          "**/*.txt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YOLO-Forge SP"
    }
  }
}